.sd-article{--sd-accent:#d6447a;--sd-accent-dark:#b02f61;--sd-navy:#3a1f2b;--sd-sub:#8a6975;line-height:2;color:#333;font-size:1.02em;}
.sd-article p{margin:0 0 1.3em;}
.sd-article .sd-lead{font-size:1.04em;margin:0 0 30px;}
.sd-article .sd-catch{position:relative;margin:0 0 28px;padding:28px 24px;background:linear-gradient(135deg,#fdeef3 0%,#fff 60%);border-left:6px solid var(--sd-accent);border-radius:8px;}
.sd-article .sd-catch p{margin:0;font-size:clamp(20px,3.2vw,28px);font-weight:800;line-height:1.55;letter-spacing:.02em;color:var(--sd-navy);}
.sd-article .sd-mark{background:linear-gradient(transparent 62%, #f6c9da 62%);font-weight:700;padding:0 2px;}
.sd-article .sd-point{position:relative;margin:24px 0;padding:18px 22px 18px 26px;background:#fdeef3;border-left:5px solid var(--sd-accent);border-radius:0 10px 10px 0;font-weight:800;color:var(--sd-navy);font-size:1.03em;line-height:1.9;}
.sd-article .sd-profile{display:flex;gap:18px;align-items:flex-start;background:#fdf2f6;border:1px solid #f5d6e3;border-radius:12px;padding:20px;margin:0 0 34px;flex-wrap:wrap;}
.sd-article .sd-profile img{width:120px;height:120px;object-fit:cover;object-position:78% 35%;border-radius:50%;flex:0 0 auto;border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.08);}
.sd-article .sd-profile .sd-pf-body{flex:1;min-width:220px;}
.sd-article .sd-profile .sd-pf-name{font-size:18px;font-weight:800;color:var(--sd-navy);margin-bottom:2px;}
.sd-article .sd-profile .sd-pf-nick{font-size:13px;color:var(--sd-accent-dark);font-weight:700;margin-bottom:8px;}
.sd-article .sd-profile .sd-pf-tags{font-size:.9em;color:var(--sd-sub);}
.sd-article .sd-profile .sd-pf-tags span{display:inline-block;background:#f8dce8;color:var(--sd-accent-dark);border-radius:999px;padding:3px 12px;margin:2px 4px 2px 0;font-weight:700;font-size:.92em;}
.sd-article h2.sd-q{position:relative;font-size:clamp(19px,2.5vw,24px);font-weight:800;line-height:1.5;margin:52px 0 24px;padding:0 0 14px 44px;border-bottom:2px solid #f5d6e3;}
.sd-article h2.sd-q::before{content:"Q";position:absolute;left:0;top:-2px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:var(--sd-accent);color:#fff;font-weight:800;font-size:.9em;border-radius:50%;}
.sd-article figure.sd-fig{margin:30px 0;}
.sd-article figure.sd-fig img{width:100%;height:auto;border-radius:10px;display:block;}
.sd-article figure.sd-fig figcaption{margin-top:8px;font-size:.85em;color:var(--sd-sub);text-align:center;}
.sd-article .sd-message{margin:26px 0;padding:24px 26px;background:#fdeef3;border-radius:10px;font-weight:700;color:var(--sd-navy);font-size:1.05em;line-height:2;}
.sd-article .sd-cta{position:relative;overflow:hidden;background:#2a1620;color:#fff;border-radius:16px;padding:48px 26px;text-align:center;margin:52px 0 8px;box-shadow:0 14px 34px rgba(42,22,32,.28);}
.sd-article .sd-cta__bg{position:absolute;inset:-12px;z-index:0;background-image:linear-gradient(120deg,rgba(50,22,36,.46) 0%,rgba(214,68,122,.22) 45%,rgba(34,16,24,.56) 100%),url('__CTA_BG__');background-size:cover;background-position:center 55%;filter:blur(4px) brightness(.95) saturate(1.08);}
.sd-article .sd-cta::before{content:"";position:absolute;inset:0;z-index:1;background:radial-gradient(circle at 88% 12%,rgba(246,201,218,.30),transparent 55%);pointer-events:none;}
.sd-article .sd-cta__eyebrow{position:relative;z-index:2;display:inline-block;background:rgba(255,255,255,.16);border:1px solid rgba(246,214,227,.55);color:#fbe0ea;font-size:12px;font-weight:bold;letter-spacing:.05em;padding:5px 16px;border-radius:30px;margin-bottom:16px;text-shadow:0 1px 4px rgba(0,0,0,.4);}
.sd-article .sd-cta p{position:relative;z-index:2;margin:0;font-size:clamp(16px,2.2vw,19px);font-weight:700;line-height:1.9;color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.6);}
.sd-article .sd-cta a.sd-btn{position:relative;z-index:2;display:inline-block;background:var(--sd-accent);color:#fff !important;text-decoration:none !important;font-weight:800;padding:15px 40px;border-radius:999px;font-size:1.05em;margin-top:22px;transition:transform .2s ease,box-shadow .2s ease,background .2s ease;box-shadow:0 10px 24px rgba(42,22,32,.35);}
.sd-article .sd-cta a.sd-btn:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(214,68,122,.45);background:var(--sd-accent-dark);}
.sd-article .sd-related{margin:44px 0 8px;}
.sd-article .sd-related h3{font-size:18px;font-weight:800;color:var(--sd-navy);margin:0 0 16px;padding-bottom:10px;border-bottom:2px solid #f5d6e3;}
.sd-article a.sd-related-card{display:flex;gap:16px;align-items:center;padding:16px;border:1px solid #f5d6e3;border-radius:10px;margin-bottom:14px;text-decoration:none !important;color:inherit;transition:box-shadow .2s ease,transform .2s ease;}
.sd-article a.sd-related-card:hover{box-shadow:0 6px 18px rgba(0,0,0,.08);transform:translateY(-2px);}
.sd-article a.sd-related-card img{width:110px;height:110px;object-fit:cover;border-radius:8px;flex:0 0 auto;}
.sd-article a.sd-related-card .sd-rel-body{flex:1;min-width:0;}
.sd-article a.sd-related-card .sd-rel-title{font-weight:800;color:var(--sd-navy);font-size:1.02em;margin:0 0 6px;}
.sd-article a.sd-related-card .sd-rel-desc{font-size:.88em;color:var(--sd-sub);margin:0;line-height:1.7;}
@media(max-width:600px){
  .sd-article h2.sd-q{padding-left:40px;}
  .sd-article .sd-profile{flex-direction:column;align-items:center;text-align:center;}
  .sd-article a.sd-related-card{flex-direction:column;align-items:flex-start;}
  .sd-article a.sd-related-card img{width:100%;height:160px;}
}
